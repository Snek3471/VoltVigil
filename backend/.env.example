# MongoDB connection string (local or Atlas). Required.
MONGO_URI=mongodb://localhost:27017/voltvigil
# Port the Express + Socket.io server listens on.
PORT=5000
# Base URL of the Python ML service (ml/app.py).
ML_SERVICE_URL=http://localhost:5001

# Optional: Gmail account used to email high/critical alerts to subscribers.
# Leave EMAIL_USER/EMAIL_PASS unset to use mock email: alerts are logged, not sent.
# Use a Gmail App Password (Google Account > Security > App passwords), never your real password.
EMAIL_USER=your-account@gmail.com
# 16-character Gmail App Password.
EMAIL_PASS=your-16-char-app-password
# Optional "From" header; defaults to "VoltVigil Alerts <EMAIL_USER>".
EMAIL_FROM=VoltVigil Alerts <your-account@gmail.com>
